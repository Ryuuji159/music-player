generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum QueueStatus {
  queued
  playing
  paused
}

enum SongRequestStatus {
  pending
  approved
  rejected
}

enum UserRole {
  admin
  user
}

model Venue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  users        User[]  @relation("UserVenues")
  queueItems   QueueItem[]
  songRequests SongRequest[]
  playlists    Playlist[]
  mediaErrors  VenueMediaError[]
  invites      VenueInvite[]
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(user)
  createdAt    DateTime @default(now())

  venues Venue[] @relation("UserVenues")
}

model Session {
  sid       String   @id
  data      Json
  expiresAt DateTime
}

model VenueInvite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model VenueMediaError {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @db.Uuid
  mediaId   String   @db.Uuid
  errorCode Int
  createdAt DateTime @default(now())

  venue Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([venueId, mediaId])
}

model MediaItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  videoId      String
  title        String
  channelTitle String
  thumbnailUrl String
  duration     String
  embeddable   Boolean

  queues        QueueItem[]
  playlistItems PlaylistItem[]
  requests      SongRequest[]
  mediaErrors   VenueMediaError[]
}

model QueueItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  position    Float
  status      QueueStatus @default(queued)
  mediaId     String      @db.Uuid
  venueId     String      @db.Uuid
  requestedBy String?

  media MediaItem @relation(fields: [mediaId], references: [id])
  venue Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model SongRequest {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaId     String            @db.Uuid
  venueId     String            @db.Uuid
  status      SongRequestStatus @default(pending)
  requestedBy String?
  createdAt   DateTime          @default(now())

  media MediaItem @relation(fields: [mediaId], references: [id])
  venue Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Playlist {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playlistId   String
  venueId      String   @db.Uuid
  title        String
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  venue Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@unique([venueId, playlistId])
}

model PlaylistItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playlistId String    @db.Uuid
  mediaId    String    @db.Uuid
  position   Int
  playlist   Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media      MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([playlistId, mediaId])
}
