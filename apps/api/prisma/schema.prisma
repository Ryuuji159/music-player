generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum QueueStatus {
  queued
  playing
  paused
}

model MediaItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 
  videoId String
  title String
  channelTitle String
  thumbnailUrl String
  duration String
  embeddable Boolean

  queues QueueItem[]
}

model QueueItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  position Float
  status QueueStatus @default(queued)
  mediaId String @db.Uuid

  media MediaItem @relation(fields: [mediaId], references: [id])
}
