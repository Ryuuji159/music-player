{
  "name": "player",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @skrd/contracts && npm run build -w api && npm run build -w web",
    "dev:api": "npm run start:dev -w api",
    "seed": "npm run seed -w api",
    "dev:web": "npm run dev -w web",
    "dev:contracts": "npm run dev -w @skrd/contracts",
    "typecheck": "npm run build -w @skrd/contracts && npm run typecheck -w web && npm run build -w api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.20.0"
  }
}
